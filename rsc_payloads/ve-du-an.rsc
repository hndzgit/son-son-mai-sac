0:["_w6excJGTCRbJVHnNuGcc",[[["",{"children":["ve-du-an",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["ve-du-an",{"children":["__PAGE__",{},[["$L1",["$","article",null,{"id":"son-son-mai-sac","className":"editorial-page project-page project_page__UA7p9","children":[["$","section",null,{"className":"project_hero__Oebd7","aria-labelledby":"project-title","children":[["$","img",null,{"src":"/story-assets/project-ivory-vase-v5.webp","alt":"Bình sơn mài nền ngà với hoa khảm và nhánh vàng, hình minh họa"}],["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"SƠN SON MÀI SẮC · DỰ ÁN TRUYỀN THÔNG VĂN HÓA"}],["$","h1",null,{"id":"project-title","className":"project_projectLogo__lx4aI","children":["$","span",null,{"className":"BrandMark_mark__I_sjn brand-mark","role":"img","aria-label":"Sơn Son Mài Sắc","children":["$","img",null,{"src":"/story-assets/brand-9782.png","alt":"","width":"880","height":"560"}]}]}],["$","p",null,{"className":"project_lead__ceTTT","children":"Đi qua từng đường mài, khám phá giá trị Việt."}],["$","p",null,{"children":"Sơn Son Mài Sắc là dự án truyền thông văn hóa hướng đến việc đưa những giá trị của sơn mài Việt Nam đến gần hơn với người trẻ, đặc biệt là những người đã từng nhìn thấy, từng biết đến sơn mài nhưng chưa có nhiều cơ hội để hiểu sâu về loại hình nghệ thuật và thủ công này."}],["$","a",null,{"className":"btn red","href":"#gioi-thieu-du-an","children":"Tìm hiểu thêm →"}]]}]]}],["$","section",null,{"className":"project_projectStory__zaR3l","id":"gioi-thieu-du-an","aria-labelledby":"project-story-title","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"GIỚI THIỆU DỰ ÁN"}],["$","h2",null,{"id":"project-story-title","children":["Từ thấy “đẹp”",["$","br",null,{}],"đến hiểu “đẹp”"]}],["$","p",null,{"children":"Đằng sau một bề mặt sơn mài hoàn thiện là nhiều lớp chất liệu, kỹ thuật, thời gian và công sức của người làm nghề. Chính khoảng cách giữa “thấy đẹp” và “hiểu vì sao đẹp” khiến nhiều giá trị nằm phía sau thành phẩm như quy trình tạo tác, kỹ nghệ, vai trò của nghệ nhân và chiều sâu văn hóa chưa được nhận diện đầy đủ. Đây cũng là vấn đề mà dự án xác định cần được giải quyết bằng một cách tiếp cận trực quan và gần gũi hơn với người trẻ."}],["$","p",null,{"children":"Từ đó, Sơn Son Mài Sắc lựa chọn cách kể “đi từ bề mặt đến chiều sâu – từ thấy đẹp đến hiểu đẹp”, đưa công chúng lần lượt khám phá chất liệu, kỹ thuật, thời gian, con người và những giá trị văn hóa được gửi gắm trong sơn mài Việt Nam."}]]}],["$","aside",null,{"children":[["$","p",null,{"className":"eyebrow","children":"Ý NGHĨA TÊN GỌI"}],["$","h3",null,{"children":"Sơn Son Mài Sắc"}],["$","p",null,{"children":"Tên gọi “Sơn Son Mài Sắc” cũng được hình thành từ những yếu tố gắn trực tiếp với nghề:"}],["$","dl",null,{"className":"project_nameMeaning__2ZB26","children":[["$","div",null,{"children":[["$","dt",null,{"children":"Sơn"}],["$","dd",null,{"children":"gợi chất liệu và nghề sơn mài."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Son"}],["$","dd",null,{"children":"gợi sắc son và sự bền bỉ."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Mài"}],["$","dd",null,{"children":"là kỹ thuật đặc trưng của quá trình tạo tác."}]]}],["$","div",null,{"children":[["$","dt",null,{"children":"Sắc"}],["$","dd",null,{"children":"gợi vẻ đẹp thị giác và rộng hơn là bản sắc văn hóa."}]]}]]}],["$","p",null,{"children":"Qua bốn chữ ấy, dự án mở ra hành trình từ những gì có thể nhìn thấy trên bề mặt đến những giá trị sâu hơn được tạo nên bởi nghề và người làm nghề."}],["$","p",null,{"className":"project_projectStoryClose__dBA7g","children":"Từ thấy đẹp → đến hiểu đẹp → để thêm trân trọng giá trị Việt."}]]}]]}],["$","section",null,{"className":"project_mission__f2EwM","id":"su-menh","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"TẦM NHÌN"}],["$","h2",null,{"children":"Để sơn mài không chỉ được nhìn thấy, mà được hiểu và trân trọng."}],["$","p",null,{"children":"Sơn Son Mài Sắc hướng tới một cách nhìn gần gũi hơn về sơn mài Việt Nam, nơi những giá trị truyền thống không chỉ được nhắc đến như dấu vết của quá khứ mà tiếp tục được nhận diện, cảm nhận và thưởng thức trong đời sống hôm nay."}],["$","p",null,{"children":"Dự án mong muốn góp phần để người trẻ nhìn sơn mài như một giá trị văn hóa sống — được hình thành từ chất liệu, kỹ thuật, tư duy thẩm mỹ, tri thức nghề và những con người đang tiếp tục gìn giữ, thực hành và làm mới nghề qua từng thế hệ."}]]}],["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"SỨ MỆNH"}],["$","h3",null,{"children":"Đưa người trẻ đi từ “thấy đẹp” đến “hiểu vì sao đẹp”."}],["$","p",null,{"children":"Sơn Son Mài Sắc sử dụng ngôn ngữ truyền thông trực quan, đương đại và dễ tiếp cận để mở ra những lớp giá trị phía sau một bề mặt sơn mài."}],["$","p",null,{"children":"Thông qua việc giải thích chất liệu, quy trình, kỹ thuật, thời gian tạo tác và câu chuyện của người làm nghề, dự án giúp người trẻ có một điểm bắt đầu dễ dàng hơn để khám phá sơn mài, từng bước hình thành hiểu biết, sự quan tâm và khả năng thưởng thức sâu hơn đối với giá trị văn hóa Việt Nam."}],["$","$L2",null,{"href":"/kham-pha","children":"Khám phá 5 chặng tạo tác ⟶"}]]}]]}],["$","section",null,{"className":"project_team__Gn0Iu","id":"doi-ngu","children":[["$","div",null,{"className":"project_teamHead___OCeu","children":["$","div",null,{"children":[["$","p",null,{"className":"eyebrow","children":"NHÓM SƠN SON MÀI SẮC"}],["$","h2",null,{"children":"Những người thực hiện"}],["$","p",null,{"children":"Năm thành viên cùng đảm nhận các vai trò trong dự án."}]]}]}],["$","div",null,{"className":"team-portrait-v4","children":["$","div",null,{"className":"team-portrait-v4-grid","aria-label":"Nhóm Sơn Son Mài Sắc","children":[["$","article","Đỗ Nguyễn Đan Lê",{"className":"team-portrait-v4-card is-featured","children":[["$","div",null,{"className":"tea